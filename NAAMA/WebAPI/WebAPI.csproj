<!-- הגדרות פרויקט ה־ASP.NET Core API והתלויות שלו בשאר שכבות המערכת. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- גרסת .NET והגדרות nullable וה־usings האוטומטיים. -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- חבילת OpenAPI וכלי EF Core של פרויקט ה־API. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.18" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- שכבות ה־DTO, הלוגיקה והנתונים שבהן משתמש ה־API. -->
    <ProjectReference Include="..\DTO\DTO.csproj" />
    <ProjectReference Include="..\BLL\BLL.csproj" />
    <ProjectReference Include="..\DAL\DAL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- תיקייה וירטואלית לתיקיית הבקרים בפרויקט. -->
    <Folder Include="Controllers\" />
  </ItemGroup>

</Project>
