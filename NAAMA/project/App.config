<?xml version="1.0" encoding="utf-8" ?>
<!-- הגדרות זמן הריצה של פרויקט .NET Framework הישן. -->
<configuration>
    <!-- הגדרות startup קובעות איזו גרסת סביבת .NET תיטען בהפעלת היישום. -->
    <startup> 
        <!-- הפרויקט דורש את .NET Framework 4.8.1 לצורך הרצה. -->
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
    </startup>
</configuration>